<xacro:macro name="inertial_tool_link" params="reflect">
    <inertial>
        <origin
        xyz="5.0493E-18 -4.4892E-17 -0.0068514"
        rpy="0 0 0" />
        <mass value="0.10189" />
        <inertia
        ixx="5.1076E-05"
        ixy="-1.0374E-21"
        ixz="-5.9164E-21"
        iyy="5.0882E-05"
        iyz="-8.5211E-21"
        izz="9.705E-05" />
    </inertial>
</xacro:macro>

<xacro:macro name="origin_joint_tool" params="reflect">
    <origin xyz="0 0 0.0184" rpy="0 ${-90.0 * deg_to_rad} ${90.0 * deg_to_rad}" />
</xacro:macro>

</robot>
